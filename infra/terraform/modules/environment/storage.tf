# Media: private, uniform access, public access prevention enforced. Clients only
# ever see short-lived signed URLs generated by the API.
resource "google_storage_bucket" "media" {
  name                        = "${var.project_id}-media-${local.env}"
  location                    = var.region
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = !var.deletion_protection

  versioning {
    enabled = var.media_versioning
  }

  lifecycle_rule {
    condition {
      days_since_noncurrent_time = 30
      with_state                 = "ARCHIVED"
    }
    action {
      type = "Delete"
    }
  }

  cors {
    origin          = local.web_origins
    method          = ["GET", "PUT"]
    response_header = ["Content-Type"]
    max_age_seconds = 3600
  }

  labels = {
    app         = "barterly"
    environment = local.env
  }
}

# Static: Django admin and API assets, public read, written only by the migrate job.
resource "google_storage_bucket" "static" {
  name                        = "${var.project_id}-static-${local.env}"
  location                    = var.region
  uniform_bucket_level_access = true
  force_destroy               = true

  cors {
    origin          = ["*"]
    method          = ["GET"]
    response_header = ["Content-Type"]
    max_age_seconds = 3600
  }

  labels = {
    app         = "barterly"
    environment = local.env
  }
}

resource "google_storage_bucket_iam_member" "static_public" {
  bucket = google_storage_bucket.static.name
  role   = "roles/storage.objectViewer"
  member = "allUsers"
}

resource "google_storage_bucket_iam_member" "api_media" {
  bucket = google_storage_bucket.media.name
  role   = "roles/storage.objectUser"
  member = google_service_account.api.member
}

resource "google_storage_bucket_iam_member" "migrate_static" {
  bucket = google_storage_bucket.static.name
  role   = "roles/storage.objectUser"
  member = google_service_account.migrate.member
}
