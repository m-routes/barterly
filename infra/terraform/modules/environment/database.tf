# Cloud SQL for PostgreSQL in the same region as Cloud Run.
#
# Access: the instance has a public IP but no authorized networks, so the only way in
# is the Cloud SQL connector (built into Cloud Run), which checks IAM
# (roles/cloudsql.client) and encrypts traffic. Direct TCP connections must use TLS.
#
# Password: generated by an ephemeral resource and passed only to write-only
# arguments, so it is never stored in Terraform state or plans. Rotate by bumping
# var.db_password_version, applying, then redeploying: revisions read the secret at
# startup, so running instances fail to open new connections until replaced.

locals {
  db_instance_name = "barterly-${local.env}"
  db_name          = "barterly"
  db_user          = "barterly"
}

resource "google_sql_database_instance" "main" {
  name                = local.db_instance_name
  region              = var.region
  database_version    = "POSTGRES_16" # matches local development and CI
  deletion_protection = var.deletion_protection

  settings {
    edition                     = "ENTERPRISE"
    tier                        = var.db_tier
    availability_type           = var.db_high_availability ? "REGIONAL" : "ZONAL"
    disk_type                   = "PD_SSD"
    disk_size                   = var.db_disk_size_gb
    disk_autoresize             = true
    deletion_protection_enabled = var.deletion_protection

    backup_configuration {
      enabled                        = true
      point_in_time_recovery_enabled = true
      start_time                     = "20:30" # UTC = 02:00 IST
      transaction_log_retention_days = 7

      backup_retention_settings {
        retained_backups = var.db_backup_retention
      }
    }

    ip_configuration {
      ipv4_enabled = true
      ssl_mode     = "ENCRYPTED_ONLY"
    }

    maintenance_window {
      day          = 7  # Sunday
      hour         = 21 # UTC = 02:30 IST Monday
      update_track = "stable"
    }

    insights_config {
      query_insights_enabled = true
    }

    user_labels = {
      app         = "barterly"
      environment = local.env
    }
  }
}

resource "google_sql_database" "main" {
  name     = local.db_name
  instance = google_sql_database_instance.main.name
}

ephemeral "random_password" "db" {
  length  = 40
  special = false # keeps the connection URL free of characters that need escaping
}

resource "google_sql_user" "app" {
  name                = local.db_user
  instance            = google_sql_database_instance.main.name
  password_wo         = ephemeral.random_password.db.result
  password_wo_version = var.db_password_version
}

# DATABASE_URL for the API and the migrate job: Unix socket of the Cloud Run
# connector, mounted at /cloudsql (see run.tf).
resource "google_secret_manager_secret_version" "database_url" {
  secret = google_secret_manager_secret.this["database_url"].id
  secret_data_wo = format(
    "postgres://%s:%s@%s/%s",
    local.db_user,
    ephemeral.random_password.db.result,
    urlencode("/cloudsql/${google_sql_database_instance.main.connection_name}"),
    local.db_name,
  )
  secret_data_wo_version = var.db_password_version

  depends_on = [google_sql_user.app, google_sql_database.main]
}

# Runtime identities that connect through the connector.
resource "google_project_iam_member" "cloudsql_client" {
  for_each = {
    api     = google_service_account.api.member
    migrate = google_service_account.migrate.member
  }

  project = var.project_id
  role    = "roles/cloudsql.client"
  member  = each.value
}
