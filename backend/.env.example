# Copy to backend/.env for local development. Never commit real values.
# Local runs use config.settings.local (the manage.py default).
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://barterly:barterly@localhost:5432/barterly

# Staging/production only (set on Cloud Run by Terraform; secrets come from Secret Manager):
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS,
# DATABASE_URL (Cloud SQL socket: postgres://USER:PASS@%2Fcloudsql%2FPROJECT%3AREGION%3AINSTANCE/DB),
# GS_MEDIA_BUCKET, GS_STATIC_BUCKET, GS_SA_EMAIL
# Optional tuning: DB_POOL_MAX_SIZE (4), DB_POOL_MIN_SIZE (1), DB_POOL_TIMEOUT (10),
# DB_CONNECT_TIMEOUT (10), DB_CONNECT_ATTEMPTS (4), DB_CONNECT_RETRY_DELAY (0.5),
# DB_CONN_MAX_AGE (local only, 0), GS_SIGNED_URL_SECONDS (900), WEB_CONCURRENCY (2)

# Logging and errors (all environments):
# LOG_FORMAT=json|plain (json deployed, plain locally), DJANGO_LOG_LEVEL=INFO,
# API_DOCS_ENABLED=1 (Swagger UI; always off in production),
# SENTRY_ENABLED=0, SENTRY_DSN (Secret Manager), SENTRY_TRACES_SAMPLE_RATE=0.0, SENTRY_RELEASE

# Sign-in (Firebase phone OTP -> SimpleJWT). FIREBASE_PROJECT_ID is set by Terraform when
# deployed; locally only needed to exercise real Firebase tokens.
# FIREBASE_PROJECT_ID=, FIREBASE_CHECK_REVOKED=0, JWT_ACCESS_MINUTES=15, JWT_REFRESH_DAYS=30,
# THROTTLE_AUTH_EXCHANGE_IP=60/hour, THROTTLE_AUTH_EXCHANGE_PHONE=10/hour,
# TRUSTED_PROXY_COUNT (0 locally, 1 deployed: Google's front end appends the client IP)

# Uploads (signed Cloud Storage URLs to GS_MEDIA_BUCKET; locally, set it to a test bucket
# to try uploads): MEDIA_UPLOAD_URL_SECONDS=900, MEDIA_READ_URL_SECONDS=300,
# MEDIA_MAX_PENDING_UPLOADS=20, MEDIA_REQUIRE_SCAN=0, THROTTLE_MEDIA_UPLOAD=120/hour

# Verification: the fake KYC provider signs its webhooks with this (local only).
# KYC_WEBHOOK_SECRET=local-only-fake-kyc-webhook-secret
