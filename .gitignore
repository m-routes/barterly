# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets (never commit)
.env
.env.*
!.env.example
*.pem
service-account*.json
google-services.json
GoogleService-Info.plist

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.sqlite3
staticfiles/

# Node / Next.js
node_modules/
.next/
out/
web/coverage/
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# Flutter / Dart
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/coverage/
backend/openapi.yaml

# Terraform (commit .terraform.lock.hcl; never commit state or real tfvars)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
!terraform.tfvars.example
