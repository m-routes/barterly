# Copy to .env.local for `npm run dev`. All values are read on the server at request
# time (no NEXT_PUBLIC_*), so one build works for every environment.

# The Django API. The browser never calls it directly: /api/v1/* on this site forwards to it.
API_URL=http://localhost:8000

# Firebase web app config for phone sign-in (Firebase console -> Project settings ->
# Your apps -> Web app). Public values, not secrets. Leave blank and /login says
# sign-in isn't available.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# Defaults to <project id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=
